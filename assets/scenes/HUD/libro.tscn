default_text = "Some people say that dreams can come true; others say that there are infinite versions of you in equally infinite realities. If you believe these claims, you're already halfway through achieving your wishes. By SHIFTING, you can access these realities."

[node name="BookTextRight" type="Control" parent="." unique_id=1444604264]
offset_left = -10.0
offset_top = -46.0
offset_right = 100.0
offset_bottom = 102.0
mouse_filter = 2
script = ExtResource("3_page")
font_size = 10
default_text = "Whenever you're in a deep slumber, you'll be able to reach into the depths of your mind, and if you're brave enough to conquer your fears, you'll be capable of shifting into the reality your heart desires. But be careful: if you stay too long in a light and beautiful dream, you'll eventually wake up."
